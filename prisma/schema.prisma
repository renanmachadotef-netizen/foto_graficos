generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model CompanySettings {
  id          String   @id @default(cuid())
  tenantId    String   @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  companyName String?
  document    String?  // CNPJ
  phone       String?
  email       String?
  address     String?
  pixKey      String?  // Chave Pix da empresa para o PDV
  
  rent        Float    @default(0)
  energy      Float    @default(0)
  internet    Float    @default(0)
  otherFixed  Float    @default(0)
  workingCap  Float    @default(0)
  
  taxRate     Float    @default(0)
  cardFeeRate Float    @default(0)

  updatedAt   DateTime @updatedAt
}

model User {
  id             String          @id @default(cuid())
  tenantId       String          @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name           String
  email          String          @unique
  password       String
  role           String          @default("SELLER") // "ADMIN", "MANAGER", "SELLER", "PRODUCTION"
  avatar         String?
  active         Boolean         @default(true)
  quotes         Quote[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Client {
  id           String                 @id @default(cuid())
  tenantId     String                 @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name         String
  code         String?
  document     String? // CPF/CNPJ
  phone        String?
  email        String?
  address      String?
  gender       String? // M / F
  birthDate    DateTime?
  birthDay     Int? // 1-31 (para consulta e ordenação rápida de aniversariantes)
  birthMonth   Int? // 1-12 (para agrupar aniversariantes do mês)
  notes        String?
  status       String                 @default("Ativo")
  quotes       Quote[]
  transactions FinancialTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String   @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name        String
  category    String   @default("BALCAO") // "BALCAO", "IMPRESSAO", "FOTOS", "BEBIDAS", "DOSES", "KITS", "BRINDES", "ACABAMENTO", "OUTROS"
  price       Float
  cost        Float    @default(0)
  unit        String   @default("un") // "un", "m2", "cento", "milheiro", "par", "garrafa", "dose", "cx"
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id           String                 @id @default(cuid())
  tenantId     String                 @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  clientId     String
  client       Client                 @relation(fields: [clientId], references: [id])
  sellerId     String?
  seller       User?                  @relation(fields: [sellerId], references: [id])
  title        String
  status       String                 @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED
  totalCost    Float
  markup       Float
  finalPrice   Float
  taxRate      Float                  @default(0)
  cardFeeRate  Float                  @default(0)
  netProfit    Float                  @default(0)
  isPosSale    Boolean                @default(false)
  items        QuoteItem[]
  serviceOrder ServiceOrder?
  transactions FinancialTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model ServiceOrder {
  id           String   @id @default(cuid())
  quoteId      String   @unique
  quote        Quote    @relation(fields: [quoteId], references: [id])
  status       String   @default("WAITING") // WAITING, PREPRESS, PRINTING, FINISHING, READY, AGING, BOTTLING, PACKAGING
  priority     String   @default("NORMAL")  // LOW, NORMAL, HIGH
  deliveryDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitCost    Float
  unitPrice   Float
}

model Employee {
  id                   String @id @default(cuid())
  tenantId             String @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name                 String
  contractType         String // "CLT_SIMPLES", "CLT_NORMAL", "PJ"
  baseSalary           Float
  benefits             Float
  taxesPercentage      Float  // Ex: 40% (Simples), 70% (Lucro), 0% (PJ)
  weeklyHours          Int    // Ex: 44
  efficiencyPercentage Float  // Ex: 80% (Desconto de pausas, banheiro, etc)
  hourlyCost           Float  // Custo Hora Real (Calculado)
  steps                WorkflowStep[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Machine {
  id               String @id @default(cuid())
  tenantId         String @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name             String
  acquisitionValue Float
  usefulLifeMonths Int
  maintenanceCost  Float
  powerConsumption Float // Watts
  kwhPrice         Float @default(0.95)
  workingHours     Int   @default(120) // Expected usage hours per month
  productivity     Float @default(0) // m2 por hora (para plotters) ou garrafas/hora (para alambique/envasadora)
  hourlyCost       Float @default(0) // Custo hora final calculado
  steps            WorkflowStep[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Material {
  id           String          @id @default(cuid())
  tenantId     String          @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name         String
  category     String          @default("VINIL_LONA") // "VINIL_LONA", "RIGIDOS_CHAPAS", "CACHACA_GRANEL", "GARRAFAS_VIDRO", "TAMPAS_ROLHAS", "ROTULOS_LACRES", "EMBALAGENS_CAIXAS", "OUTROS"
  unit         String          // "m2", "ml", "un", "litro", "lacre", "cx"
  unitCost     Float           // Custo por unidade
  currentStock Float           @default(0) // Estoque atual
  minStock     Float           @default(0) // Estoque de segurança/mínimo
  width        Float?          // Largura do rolo em metros (para gráficas) ou capacidade em ml (para garrafas)
  wasteMargin  Float           @default(0) // % de perda técnica/evaporação
  movements    StockMovement[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type       String   // "IN" (Entrada), "OUT" (Saída Manual), "OS_OUT" (Baixa Automática OS), "ADJUSTMENT" (Balanço)
  quantity   Float
  unitCost   Float?
  notes      String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model ProductionWorkflow {
  id           String @id @default(cuid())
  name         String
  steps        WorkflowStep[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkflowStep {
  id               String @id @default(cuid())
  workflowId       String
  workflow         ProductionWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order            Int
  machineId        String?
  machine          Machine? @relation(fields: [machineId], references: [id])
  employeeId       String?
  employee         Employee? @relation(fields: [employeeId], references: [id])
  setupTimeMinutes Float @default(0)
  unitTimeMinutes  Float @default(0)
}

model Financing {
  id               String @id @default(cuid())
  description      String
  totalValue       Float
  installments     Int
  installmentValue Float
  startDate        DateTime
  createdAt        DateTime @default(now())
}

model FinancialTransaction {
  id            String    @id @default(cuid())
  tenantId      String    @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  date          DateTime  @default(now())
  dueDate       DateTime  @default(now())
  paymentDate   DateTime?
  description   String
  amount        Float
  type          String    // "INCOME" (A Receber) ou "EXPENSE" (A Pagar)
  status        String    @default("PENDING") // "PENDING", "PAID", "CANCELLED"
  category      String?
  paymentMethod String?   // "PIX", "BOLETO", "CARD_CREDIT", "CARD_DEBIT", "CASH", "TRANSFER", "OTHER"
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FixedCost {
  id        String   @id @default(cuid())
  tenantId  String   @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name      String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
