generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model CompanySettings {
  id          String   @id @default(cuid())
  tenantId    String   @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  companyName String?
  document    String?  // CNPJ
  phone       String?
  email       String?
  address     String?
  pixKey      String?  // Chave Pix da empresa para o PDV
  
  rent        Float    @default(0)
  energy      Float    @default(0)
  internet    Float    @default(0)
  otherFixed  Float    @default(0)
  workingCap  Float    @default(0)
  
  taxRate     Float    @default(0)
  cardFeeRate Float    @default(0)

  updatedAt   DateTime @updatedAt
}

model User {
  id             String          @id @default(cuid())
  tenantId       String          @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name           String
  email          String          @unique
  password       String
  role           String          @default("SELLER") // "ADMIN", "MANAGER", "SELLER", "PRODUCTION"
  avatar         String?
  active         Boolean         @default(true)
  quotes         Quote[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Client {
  id           String                 @id @default(cuid())
  tenantId     String                 @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name         String
  code         String?
  document     String? // CPF/CNPJ
  phone        String?
  email        String?
  address      String?
  gender       String? // M / F
  birthDate    DateTime?
  birthDay     Int? // 1-31 (para consulta e ordenação rápida de aniversariantes)
  birthMonth   Int? // 1-12 (para agrupar aniversariantes do mês)
  notes        String?
  status       String                 @default("Ativo")
  quotes       Quote[]
  transactions FinancialTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String   @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name        String
  category    String   @default("BALCAO") // "BALCAO", "IMPRESSAO", "FOTOS", "BEBIDAS", "DOSES", "KITS", "BRINDES", "ACABAMENTO", "OUTROS"
  price       Float
  cost        Float    @default(0)
  unit        String   @default("un") // "un", "m2", "cento", "milheiro", "par", "garrafa", "dose", "cx"
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id           String                 @id @default(cuid())
  tenantId     String                 @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  clientId     String
  client       Client                 @relation(fields: [clientId], references: [id])
  sellerId     String?
  seller       User?                  @relation(fields: [sellerId], references: [id])
  title        String
  status       String                 @default("DRAFT") // DRAFT, SENT, APPROVED, REJECTED
  totalCost    Float
  markup       Float
  finalPrice   Float
  taxRate      Float                  @default(0)
  cardFeeRate  Float                  @default(0)
  netProfit    Float                  @default(0)
  isPosSale    Boolean                @default(false)
  items        QuoteItem[]
  serviceOrder ServiceOrder?
  transactions FinancialTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model ServiceOrder {
  id           String   @id @default(cuid())
  quoteId      String   @unique
  quote        Quote    @relation(fields: [quoteId], references: [id])
  status       String   @default("WAITING") // WAITING, PREPRESS, PRINTING, FINISHING, READY, AGING, BOTTLING, PACKAGING
  priority     String   @default("NORMAL")  // LOW, NORMAL, HIGH
  deliveryDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitCost    Float
  unitPrice   Float
}

model Employee {
  id                   String @id @default(cuid())
  tenantId             String @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name                 String
  contractType         String // "CLT_SIMPLES", "CLT_NORMAL", "PJ"
  baseSalary           Float
  benefits             Float
  taxesPercentage      Float  // Ex: 40% (Simples), 70% (Lucro), 0% (PJ)
  weeklyHours          Int    // Ex: 44
  efficiencyPercentage Float  // Ex: 80% (Desconto de pausas, banheiro, etc)
  hourlyCost           Float  // Custo Hora Real (Calculado)
  steps                WorkflowStep[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Machine {
  id               String @id @default(cuid())
  tenantId         String @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name             String
  acquisitionValue Float
  usefulLifeMonths Int
  maintenanceCost  Float
  powerConsumption Float // Watts
  kwhPrice         Float @default(0.95)
  workingHours     Int   @default(120) // Expected usage hours per month
  productivity     Float @default(0) // m2 por hora (para plotters) ou garrafas/hora (para alambique/envasadora)
  hourlyCost       Float @default(0) // Custo hora final calculado
  steps            WorkflowStep[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Material {
  id           String          @id @default(cuid())
  tenantId     String          @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name         String
  category     String          @default("VINIL_LONA") // "VINIL_LONA", "RIGIDOS_CHAPAS", "CACHACA_GRANEL", "GARRAFAS_VIDRO", "TAMPAS_ROLHAS", "ROTULOS_LACRES", "EMBALAGENS_CAIXAS", "OUTROS"
  unit         String          // "m2", "ml", "un", "litro", "lacre", "cx"
  unitCost     Float           // Custo por unidade
  currentStock Float           @default(0) // Estoque atual
  minStock     Float           @default(0) // Estoque de segurança/mínimo
  width        Float?          // Largura do rolo em metros (para gráficas) ou capacidade em ml (para garrafas)
  wasteMargin  Float           @default(0) // % de perda técnica/evaporação
  movements    StockMovement[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type       String   // "IN" (Entrada), "OUT" (Saída Manual), "OS_OUT" (Baixa Automática OS), "ADJUSTMENT" (Balanço)
  quantity   Float
  unitCost   Float?
  notes      String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model ProductionWorkflow {
  id           String @id @default(cuid())
  name         String
  steps        WorkflowStep[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkflowStep {
  id               String @id @default(cuid())
  workflowId       String
  workflow         ProductionWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order            Int
  machineId        String?
  machine          Machine? @relation(fields: [machineId], references: [id])
  employeeId       String?
  employee         Employee? @relation(fields: [employeeId], references: [id])
  setupTimeMinutes Float @default(0)
  unitTimeMinutes  Float @default(0)
}

model Financing {
  id               String @id @default(cuid())
  description      String
  totalValue       Float
  installments     Int
  installmentValue Float
  startDate        DateTime
  createdAt        DateTime @default(now())
}

model FinancialTransaction {
  id            String    @id @default(cuid())
  tenantId      String    @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  date          DateTime  @default(now())
  dueDate       DateTime  @default(now())
  paymentDate   DateTime?
  description   String
  amount        Float
  type          String    // "INCOME" (A Receber) ou "EXPENSE" (A Pagar)
  status        String    @default("PENDING") // "PENDING", "PAID", "CANCELLED"
  category      String?
  paymentMethod String?   // "PIX", "BOLETO", "CARD_CREDIT", "CARD_DEBIT", "CASH", "TRANSFER", "OTHER"
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FixedCost {
  id        String   @id @default(cuid())
  tenantId  String   @default("FOTOGRAFICOS") // "FOTOGRAFICOS" | "PURABRASIL"
  name      String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------
// 1. MÓDULO AGRÍCOLA & MOAGEM (Plantation, Harvest & Milling)
// -------------------------------------------------------------
model PlantationField {
  id               String             @id @default(cuid())
  tenantId         String             @default("PURABRASIL")
  name             String             // Ex: "Talhão 01 - Morro Alto"
  variety          String             // Ex: "RB867515", "SP80-1842", "Caninha Rosa"
  areaHectares     Float              // Ex: 3.5 ha
  plantingDate     DateTime?
  lastCutDate      DateTime?
  estimatedTons    Float              // Produtividade estimada (Ton)
  status           String             @default("GROWING") // "GROWING", "READY_TO_CUT", "CUT"
  costs            AgriculturalCost[]
  millingRuns      MillingRun[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model AgriculturalCost {
  id               String           @id @default(cuid())
  tenantId         String           @default("PURABRASIL")
  fieldId          String?
  field            PlantationField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  category         String           // "CORTE_TERCEIROS", "FROTA_TRATOR_DIESEL", "MANUTENCAO_CAMINHAO", "FERTILIZANTES", "DEFENSIVOS"
  description      String           // Ex: "Diaristas corte manual de cana - 20 Toneladas"
  amount           Float            // Valor total em R$
  date             DateTime         @default(now())
  createdAt        DateTime         @default(now())
}

model MillingRun {
  id                 String           @id @default(cuid())
  tenantId           String           @default("PURABRASIL")
  fieldId            String?
  field              PlantationField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  date               DateTime         @default(now())
  batchNumber        String           // Ex: "MOAGEM-2026/01"
  caneTons           Float            // Toneladas de cana moídas (ex: 5.0 Ton)
  millingHours       Float            // Horas de funcionamento da moenda (ex: 4.5h)
  juiceLiters        Float            // Litros de garapa bruta obtida (ex: 3.200 L)
  sugarBrix          Float            // °Brix da garapa fresca (ex: 19.5 °Brix)
  yieldLitersPerTon  Float            // Rendimento (Litros / Tonelada)
  operationalCost    Float            // Custo operacional da moagem (Diesel, energia, diaristas)
  costPerLiterJuice  Float            // Custo por Litro de Garapa = operationalCost / juiceLiters
  notes              String?
  fermentations      FermentationBatch[]
  createdAt          DateTime         @default(now())
}

// -------------------------------------------------------------
// 2. MÓDULO DE FERMENTAÇÃO & DESTILAÇÃO (Cuts Fractioning)
// -------------------------------------------------------------
model FermentationBatch {
  id                 String            @id @default(cuid())
  tenantId           String            @default("PURABRASIL")
  millingRunId       String?
  millingRun         MillingRun?       @relation(fields: [millingRunId], references: [id], onDelete: SetNull)
  vatNumber          String            // Ex: "DORNA-01 (Inox 1.500L)"
  juiceVolumeLiters  Float             // Volume de garapa (ex: 1.000 L)
  initialBrix        Float             // °Brix de entrada (ex: 16.0)
  fermentationHours  Float             // Tempo em dorna (ex: 28h)
  yeastType          String            // "LEVEDURA_SELVAGEM_CAIPIRA", "SACCHAROMYCES", "CAIPIRA_MILHO"
  status             String            @default("FERMENTING") // "FERMENTING", "READY_TO_DISTILL", "DISTILLED"
  finalBrix          Float?            // °Brix final (0.0 quando atinge o ponto de alambique)
  distillations      DistillationRun[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model DistillationRun {
  id                 String             @id @default(cuid())
  tenantId           String             @default("PURABRASIL")
  fermentationId     String?
  fermentation       FermentationBatch? @relation(fields: [fermentationId], references: [id], onDelete: SetNull)
  date               DateTime           @default(now())
  batchNumber        String             // Ex: "ALAMB-2026/01"
  stillNumber        String             // Ex: "Alambique de Cobre Capitel 1 (500L)"
  washVolumeInput    Float              // Litros de mosto/vinho fermentado inseridos (ex: 1.000 L)
  
  // Fracionamento Exato de Cortes
  headsLiters        Float              // Litros de Cabeça (Descarte tóxico: ~1.5% a 2%)
  headsPercentage    Float              // % Cabeça (ex: 1.8%)
  headsAbv           Float              @default(65.0) // % ABV Cabeça
  
  heartsLiters       Float              // Litros de Coração (Cachaça Nobre Aproveitável: ~16%)
  heartsPercentage   Float              // % Coração (ex: 16.2%)
  heartsAbv          Float              @default(44.0) // % ABV Coração
  
  tailsLiters        Float              // Litros de Cauda / Água Fraca (Descarte/Reciclagem: ~4%)
  tailsPercentage    Float              // % Cauda (ex: 4.0%)
  tailsAbv           Float              @default(15.0) // % ABV Cauda
  
  // Apropriação 100% dos Custos sobre o Coração
  totalRunCost       Float              // Custo total da alambicada (garapa + lenha/caldeira + operador)
  costPerLiterHeart  Float              // Custo real por Litro de Coração = totalRunCost / heartsLiters
  
  destinationBarrelId String?
  notes              String?
  createdAt          DateTime           @default(now())
}

// -------------------------------------------------------------
// 3. ADEGA DE BARRIS & ANGEL'S SHARE (Evaporation)
// -------------------------------------------------------------
model Barrel {
  id                    String           @id @default(cuid())
  tenantId              String           @default("PURABRASIL")
  code                  String           // Ex: "BARRIL-01", "DORNA-03"
  woodType              String           // "CARVALHO_AMERICANO", "CARVALHO_FRANCES", "AMBURANA", "BALSAMO", "JEQUITIBA", "INOX"
  capacityLiters        Float            // Ex: 200.0
  currentLiters         Float            // Ex: 185.0
  costPerLiter          Float            @default(12.0) // Custo contábil atual por litro (sobe com o Angel's Share)
  evaporationRateAnnual Float            @default(3.0)  // Taxa anual de Angel's Share (%)
  lastEvaporationDate   DateTime?        // Data do último abate de evaporação
  abvPercentage         Float            // Ex: 42.0 (% Álcool)
  fillDate              DateTime         // Data de início do envelhecimento
  batchNumber           String           // Lote / Alambicada
  status                String           @default("AGING") // "AGING", "READY", "EMPTY", "BOTTLING", "BLENDING"
  sensoryNotes          String?          // Notas sensoriais (baunilha, floral, especiarias)
  location              String?          // Posição na adega
  movements             BarrelMovement[]
  blendItems            BlendItem[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model BarrelMovement {
  id              String   @id @default(cuid())
  tenantId        String   @default("PURABRASIL")
  barrelId        String
  barrel          Barrel   @relation(fields: [barrelId], references: [id], onDelete: Cascade)
  type            String   // "INPUT" (Alambicada), "OUTPUT" (Envase), "TRANSFER" (Blending), "ANGELS_SHARE" (Evaporação), "LOSS" (Amostra)
  liters          Float    // Litros movimentados
  resultingLiters Float    // Saldo após a movimentação
  costPerLiterAfter Float  @default(12.0) // Custo por litro recalculado
  date            DateTime @default(now())
  batchNumber     String?
  abvPercentage   Float?
  responsibleName String?
  notes           String?
  createdAt       DateTime @default(now())
}

// -------------------------------------------------------------
// 4. BLENDS & LICORES FINOS (Multi-barrel Blends & Fruit Liqueurs)
// -------------------------------------------------------------
model BlendBatch {
  id                  String      @id @default(cuid())
  tenantId            String      @default("PURABRASIL")
  name                String      // Ex: "Blend 3 Madeiras Safra Ouro"
  batchNumber         String      // Ex: "BLEND-2026/01"
  date                DateTime    @default(now())
  totalLiters         Float       // Volume total do blend obtido
  averageCostPerLiter Float       // Custo Médio Ponderado por Litro
  finalAbv            Float       // % ABV ponderado final
  destinationBarrelId String?     // Barril de descanso do blend
  notes               String?
  items               BlendItem[]
  createdAt           DateTime    @default(now())
}

model BlendItem {
  id             String     @id @default(cuid())
  blendBatchId   String
  blendBatch     BlendBatch @relation(fields: [blendBatchId], references: [id], onDelete: Cascade)
  barrelId       String
  barrel         Barrel     @relation(fields: [barrelId], references: [id], onDelete: Restrict)
  litersUsed     Float      // Litros retirados deste barril
  costPerLiter   Float      // Custo por litro deste barril
  woodType       String     // Madeira de origem
}

model LiquorBatch {
  id                     String   @id @default(cuid())
  tenantId               String   @default("PURABRASIL")
  name                   String   // Ex: "Licor Fino de Banana c/ Canela e Amburana"
  flavor                 String   // "BANANA", "MARACUJA", "CAFE", "JABUTICABA", "CANELA", "DOCE_DE_LEITE"
  batchNumber            String   // Ex: "LICOR-2026/01"
  date                   DateTime @default(now())
  baseSpiritLiters       Float    // Litros de Cachaça usados
  baseSpiritCostPerLiter Float    // Custo/L da Cachaça base
  ingredientsCost        Float    // Custo externo de frutas, açúcar e insumos
  macerationDays         Int      @default(30) // Dias de maceração
  finalVolumeLiters      Float    // Volume final de licor obtido
  finalAbv               Float    @default(22.0) // % ABV do licor
  costPerLiter           Float    // Custo Total por Litro do Licor
  notes                  String?
  createdAt              DateTime @default(now())
}

// -------------------------------------------------------------
// 5. RECEITAS & FICHA TÉCNICA DE ENVASE (BOM)
// -------------------------------------------------------------
model Recipe {
  id               String   @id @default(cuid())
  tenantId         String   @default("PURABRASIL")
  name             String   // Ex: "Cachaça Amburana Extra Premium"
  category         String   @default("ENVELHECIDA") // "PRATA", "ENVELHECIDA", "PREMIUM", "EXTRA_PREMIUM", "BLEND", "LICOR"
  woodType         String   // "AMBURANA", "CARVALHO_FRANCES", "CARVALHO_AMERICANO", "BALSAMO", "JEQUITIBA", "INOX", "BLEND"
  agingMonths      Int      @default(12)
  targetAbv        Float    @default(42.0)
  sugarBrix        Float?   // °Brix da garapa
  fermentationType String?
  fermentationHours Int?
  distillationType String?
  heartCutPercent  Float?   // % Corte Coração
  sensoryProfile   String?
  instructions     String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BottlingRun {
  id                     String   @id @default(cuid())
  tenantId               String   @default("PURABRASIL")
  liquidSourceType       String   @default("BARREL") // "BARREL", "BLEND", "LIQUOR"
  sourceId               String?  // ID do Barril, Blend ou Licor
  productName            String   // Ex: "Cachaça Amburana Reserva 750ml"
  bottlesQuantity        Int      // Ex: 100
  bottleVolumeMl         Int      @default(750) // 750, 500, 160
  litersUsed             Float    // Ex: 75.0 L
  liquidCostPerLiter     Float    @default(12.0) // Custo líquido vindo da cadeia completa
  packagingCostPerBottle Float    @default(15.0) // Vidro + Rolha + Rótulos + Lacre + Caixa
  laborCostPerBottle     Float    @default(2.5)  // Mão de obra de envase
  cogsPerBottle          Float    // Custo Total Unitário da Garrafa (COGS)
  retailPrice            Float    // Preço Varejo Sugerido (PDV)
  wholesalePrice         Float    // Preço Atacado Sugerido (Caixas/B2B)
  notes                  String?
  createdAt              DateTime @default(now())
}
